{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Academia Play reconstructed curriculum research dossier v4.3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "4.3"
    },
    "university": {
      "type": "string",
      "minLength": 1
    },
    "course_name": {
      "type": "string",
      "minLength": 1
    },
    "course_code": {
      "type": "string",
      "minLength": 1
    },
    "period_scope": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "string",
      "enum": [
        "OFFICIAL_VERIFIED",
        "RECONSTRUCTED_PROPOSED",
        "RESEARCH_INSUFFICIENT"
      ]
    },
    "adoption_status": {
      "type": "string",
      "const": "PENDING_HUMAN_APPROVAL"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "INSTITUTIONAL",
              "ACADEMIC",
              "COURSE_DOCUMENT",
              "COMMUNITY",
              "TEXTBOOK",
              "OTHER"
            ]
          },
          "access_status": {
            "type": "string",
            "enum": [
              "OPENED",
              "PARTIAL",
              "NOT_ACCESSIBLE"
            ]
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "origin_id": {
            "type": "string",
            "minLength": 1
          },
          "inspected_sections": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "publication_period": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "source_id",
          "title",
          "url",
          "source_type",
          "access_status",
          "observed_at",
          "origin_id",
          "inspected_sections",
          "publication_period"
        ]
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim_id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "enum": [
              "INSTITUTIONALLY_CONFIRMED",
              "DOCUMENT_CORROBORATED",
              "ACADEMICALLY_INFERRED",
              "UNRESOLVED"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "confidence_rationale": {
            "type": "string",
            "minLength": 1
          },
          "is_core": {
            "type": "boolean"
          }
        },
        "required": [
          "claim_id",
          "text",
          "classification",
          "source_ids",
          "contradictions",
          "confidence_rationale",
          "is_core"
        ]
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "unit_id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "claim_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "foundation_notes": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "unit_id",
          "title",
          "claim_ids",
          "foundation_notes"
        ]
      }
    },
    "variations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "comparison_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "books_pending": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "research_notes": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "university",
    "course_name",
    "course_code",
    "period_scope",
    "provenance",
    "adoption_status",
    "sources",
    "claims",
    "units",
    "variations",
    "unresolved_questions",
    "comparison_notes",
    "books_pending",
    "research_notes"
  ]
}
