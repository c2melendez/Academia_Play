    {
      "path": "sistema-maestro/pilot/stem_area_grid.js",
      "blob": "1f8735a2733a8ceb6a0ebb081d8b0e0c6c43ed78",
      "content": "/* Shared formative area grid, derived from F01's positive-area organizer.\n * Schematic only. Accessible mathematical equivalents remain in the page/table.\n * No network, session, bank, evaluation or mastery state.\n */\nfunction renderStemAreaGrid(container, rows, visibleRows) {\n    if (!Array.isArray(rows) || rows.length < 1 || rows.length > 2 ||\n        !Array.isArray(rows[0]) || rows[0].length < 1 || rows[0].length > 2 ||\n        rows.some(row => !Array.isArray(row) || row.length !== rows[0].length ||\n            row.some(value => typeof value !== \"string\")) ||\n        !Number.isInteger(visibleRows) || visibleRows < 0 || visibleRows > rows.length) {\n        throw new Error(\"Organizador de áreas inválido\");\n    }\n    container.replaceChildren();\n    container.setAttribute(\"aria-hidden\", \"true\");\n    const grid = document.createElement(\"div\");\n    Object.assign(grid.style, {\n        display:\"grid\",gridTemplateColumns:\"repeat(\"+rows[0].length+\",minmax(0,1fr))\",\n        maxWidth:\"360px\",margin:\"14px 0\",border:\"2px solid #174c87\",gap:\"2px\",\n        background:\"#174c87\"\n    });\n    rows.forEach((row,r) => row.forEach((value,c) => {\n        const cell=document.createElement(\"span\");\n        cell.dataset.areaCell=\"true\";\n        cell.dataset.revealed=String(r<visibleRows);\n        cell.textContent=r<visibleRows?value:\"\";\n        Object.assign(cell.style,{\n            display:\"grid\",placeItems:\"center\",minHeight:\"68px\",padding:\"8px\",\n            overflowWrap:\"anywhere\",color:\"#18304c\",\n            background:r>=visibleRows?\"#edf1f6\":(r+c)%2?\"#fbe8bd\":\"#dcebf9\"\n        });\n        grid.append(cell);\n    }));\n    container.append(grid);\n}\n"
    },
    {
      "path": "sistema-maestro/pilot/mm110_f01.html",
      "blob": "04b8a3837034ee46677df2db3ba20f6a392db88e",
      "content": "<!doctype html>\n<html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Academia Play · F01</title><style>\n*{box-sizing:border-box}body{margin:0;background:#eff5fa;color:#18304c;font:1rem/1.6 system-ui,sans-serif}header,main{max-width:850px;margin:auto;padding:20px}header{display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px}section{background:white;border:1px solid #cbdbe8;border-radius:18px;padding:clamp(16px,4vw,32px);margin-bottom:18px}h1,h2,h3{line-height:1.2}button,select,input{font:inherit;max-width:100%;min-width:0}select{width:auto;max-width:100%}fieldset{min-width:0}button,select,input[type=text]{padding:12px;border:1px solid #63829e;border-radius:8px}button{background:#174c87;color:white;cursor:pointer}button:disabled{opacity:.55;cursor:default}button.secondary{background:white;color:#174c87}button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid #b56b00;outline-offset:3px}fieldset{border:0;padding:0}label.choice{display:block;padding:10px;border:1px solid #cbdbe8;border-radius:8px;margin:8px 0}#answer{width:100%}.actions{display:flex;flex-wrap:wrap;gap:10px}.muted{color:#4b6175}#feedback,#notice{white-space:pre-wrap} [hidden]{display:none!important}\n</style></head><body><header><strong>Academia Play · Matemática I</strong><span>Piloto local · M0/F01</span></header><main>\n<section><h1>Distribuir, transformar y justificar</h1><p id=\"notice\" role=\"status\">Conectando con el servidor…</p><p id=\"progress\" aria-live=\"polite\">Dominio: sin evaluar</p></section>\n<section id=\"review\"><h2>Repaso visual</h2><p>Un rectángulo de altura 3 y ancho x + 4 se puede dividir en dos regiones positivas.</p><div id=\"f01-area\" aria-hidden=\"true\"></div><p><strong>3(x + 4) = 3x + 12</strong>. La figura es esquemática, para x positivo; la regla algebraica a(b+c)=ab+ac vale para todos los reales.</p><h3>Fundamentos de signos y fracciones</h3><table style=\"border-collapse:collapse;width:100%;text-align:left\"><caption>Reglas de multiplicación</caption><thead><tr><th scope=\"col\">Signos</th><th scope=\"col\">Producto</th></tr></thead><tbody><tr><td>Iguales (+,+ o −,−)</td><td>Positivo</td></tr><tr><td>Distintos (+,− o −,+)</td><td>Negativo</td></tr></tbody></table><p>En fracciones, multiplica numeradores y denominadores; conserva el signo y simplifica. El denominador nunca es cero.</p><p class=\"muted\">Cada sumando recibe el mismo factor exterior. Si los factores tienen signo, aplica las reglas de multiplicación de números reales.</p></section>\n<section><h2>Elige tu experiencia</h2><label for=\"mode\">Modo</label> <select id=\"mode\"><option value=\"learning_path\">Práctica libre</option><option value=\"guided\">Ruta guiada A/B/C/T</option><option value=\"practice_tutor\">Tutor</option><option value=\"exam_preparation\">Examen individual</option><option value=\"exam_set\">Evaluación completa (5 ejercicios)</option></select><p id=\"guided-status\" role=\"status\" hidden></p><p id=\"item-select\"><label for=\"item\">Actividad</label> <select id=\"item\"></select></p><button id=\"start\" disabled>Iniciar actividad</button><p id=\"set-status\" role=\"status\" hidden></p></section>\n<section id=\"exercise\" hidden><h2 id=\"prompt\" tabindex=\"-1\"></h2><form id=\"form\"><label for=\"answer\">Expresión algebraica (usa x, / y ^)</label><input id=\"answer\" type=\"text\" maxlength=\"256\" required autocomplete=\"off\"><fieldset><legend id=\"reason\"></legend><div id=\"choices\"></div></fieldset><div class=\"actions\"><button type=\"submit\" id=\"submit\">Comprobar</button><button type=\"button\" class=\"secondary\" id=\"hint\">Solicitar pista</button></div></form><p id=\"feedback\" role=\"status\"></p><button type=\"button\" id=\"finish-exam\" hidden>Finalizar examen y revisar</button><section id=\"exam-result\" aria-labelledby=\"exam-result-title\" hidden><h3 id=\"exam-result-title\" tabindex=\"-1\">Resultado del examen</h3><p id=\"exam-score\"></p><p id=\"exam-solution\"></p><p id=\"exam-explanation\"></p><p class=\"muted\">Este resultado no modifica las evidencias de dominio de la ruta formativa.</p></section></section>\n<section id=\"pending-exams\" hidden><h2>Evaluaciones individuales pendientes</h2><p id=\"pending-status\" role=\"status\"></p><ol id=\"pending-list\"></ol></section>\n<section id=\"exam-history\" hidden><h2>Historial de exámenes</h2><p id=\"history-status\" role=\"status\"></p><ol id=\"history-list\"></ol></section>\n</main><script>/* STEM_AREA_GRID */</script><script>\n\"use strict\";\nconst $=id=>document.getElementById(id);\nrenderStemAreaGrid($(\"f01-area\"),[[\"3x\",\"12\"]],1);\nlet guided={stage:\"A\",pending:[],completed:[]};\nlet examSet=null;\nlet items=[],attempt=null,hintIndex=0,busy=false,closed=false,examRecorded=false,examFinished=false;\nconst names={\"foundation-sign\":\"A1 · Signos\",\"foundation-fraction\":\"A2 · Fracciones\",\"foundation-prediction\":\"B1 · Predicción\",\"foundation-grouping\":\"B2 · Agrupación\",\"expansion\":\"Desarrollo polinómico\",\"repair\":\"Reparación algebraica\",\"contextual\":\"Transferencia\",\"inverse\":\"Factor común\",\"rational-identity\":\"Fracciones\"};\nasync function api(path,data){const r=await fetch(\"/api/f01/\"+path,data===undefined?{}:{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify(data)});const v=await r.json();if(!r.ok)throw Error(\"Solicitud no disponible (\"+r.status+\")\");return v;}\nasync function progress(){const p=await api(\"progress\");$(\"progress\").textContent=\"Dominio: \"+({UNASSESSED:\"Sin evaluar\",DEVELOPING:\"En desarrollo\",MASTERED:\"Dominio inicial acreditado\",NEEDS_REVIEW:\"Requiere repaso\"}[p.mastery_estimate]||p.mastery_estimate)+\" · Evidencias: \"+p.evidence_count+(p.access_granted?\" · Acceso conservado\":p.mastery_estimate===\"MASTERED\"?\" · Ruta guiada pendiente para desbloquear acceso\":\"\");}\nasync function refreshHistory(){const records=await api(\"exam/history\");const list=$(\"history-list\");list.replaceChildren();$(\"history-status\").textContent=records.length?records.length+\" resultados finalizados\":\"Aún no hay exámenes finalizados.\";for(const record of records){const li=document.createElement(\"li\");const details=document.createElement(\"details\");const summary=document.createElement(\"summary\");summary.textContent=\"Puntuación: \"+record.score+\"/\"+record.maximum;details.append(summary);for(const value of [\"Tu respuesta: \"+record.answer,\"Solución: \"+record.expected,record.feedback]){const p=document.createElement(\"p\");p.textContent=value;p.style.overflowWrap=\"anywhere\";details.append(p);}li.append(details);list.append(li);}}\nasync function refreshPending(){const records=await api(\"exam/pending\");const list=$(\"pending-list\");list.replaceChildren();$(\"pending-status\").textContent=records.length?records.length+\" intentos pendientes\":\"No hay evaluaciones pendientes.\";for(const a of records){const li=document.createElement(\"li\");const p=document.createElement(\"p\");p.textContent=a.prompt+\" · \"+(a.recorded?\"Respuesta registrada\":\"Sin respuesta registrada\");const b=document.createElement(\"button\");b.type=\"button\";b.className=\"secondary\";b.textContent=a.recorded?\"Finalizar intento\":\"Continuar intento\";b.dataset.attemptId=a.attempt_id;b.disabled=busy;b.addEventListener(\"click\",()=>run(async()=>{const fresh=await api(\"exam/pending\");const item=fresh.find(i=>i.attempt_id===a.attempt_id);if(!item)throw Error(\"El intento ya no está disponible.\");renderActivity(item);if(item.recorded){closed=true;examRecorded=true;$(\"form\").hidden=true;$(\"feedback\").textContent=\"Respuesta registrada. Finaliza para consultar el resultado.\";$(\"finish-exam\").hidden=false;}}));li.append(p,b);list.append(li);}$(\"pending-exams\").hidden=$(\"mode\").value!==\"exam_preparation\"||!$(\"exercise\").hidden||!!examSet;}\nasync function refreshGuided(){guided=await api(\"guided\");$(\"guided-status\").textContent=guided.stage===\"COMPLETE\"?\"Ruta completada\":`Etapa ${guided.stage} · ${guided.completed.length}/8 actividades superadas`;if(guided.exhausted_families?.length)$(\"guided-status\").textContent+=\" · Sin variantes inéditas en: \"+guided.exhausted_families.map(f=>names[f]||f).join(\", \")+\". Continúa con repaso y tutor; se requiere ampliar el banco.\" ;if(guided.transfer_status===\"RESERVE\")$(\"guided-status\").textContent+=\" · Nueva oportunidad: variante de reserva. Revisa los fundamentos antes de resolverla sin ayuda.\";if(guided.transfer_status===\"EXHAUSTED\")$(\"guided-status\").textContent+=\" · No quedan variantes inéditas. Puedes continuar con el repaso y el tutor; se requiere ampliar el banco antes de acreditar esta ruta.\"; }\nfunction filter(reset=true){$(\"pending-exams\").hidden=true;$(\"item-select\").hidden=$(\"mode\").value===\"exam_set\";$(\"set-status\").hidden=$(\"mode\").value!==\"exam_set\"; $(\"item\").replaceChildren();for(const i of items.filter(i=>$(\"mode\").value===\"guided\"?guided.pending.includes(i.item_id):i.mode===$(\"mode\").value)){const o=document.createElement(\"option\");o.value=i.item_id;o.textContent=i.family===\"contextual\"?({\"f01-route-transfer\":\"Transferencia · Costos\",\"f01-transfer-perimeter\":\"Transferencia · Perímetro\",\"f01-transfer-discount\":\"Transferencia · Descuento\",\"f01-transfer-balance\":\"Transferencia · Saldo\",\"f01-transfer-reserve-fuel\":\"Reserva · Consumo\",\"f01-transfer-reserve-temperature\":\"Reserva · Temperatura\",\"f01-transfer-reserve-scale\":\"Reserva · Escala\",\"f01-transfer-reserve-sharing\":\"Reserva · Reparto\"}[i.item_id]||\"Transferencia\"):(names[i.family]||i.family)+(i.item_id.startsWith(\"f01-c-\")?\" · \"+(i.item_id.endsWith(\"rational\")?\"Fracciones\":i.item_id.endsWith(\"sign\")?\"Corrección de signo\":\"Signos negativos\"):\"\");$(\"item\").append(o);} $(\"exam-history\").hidden=$(\"mode\").value!==\"exam_preparation\"||!$(\"exercise\").hidden;$(\"review\").hidden=[\"exam_preparation\",\"exam_set\"].includes($(\"mode\").value);$(\"guided-status\").hidden=$(\"mode\").value!==\"guided\";if(reset){$(\"exam-history\").hidden=$(\"mode\").value!==\"exam_preparation\";$(\"exercise\").hidden=true;attempt=null;examRecorded=false;examFinished=false;$(\"finish-exam\").hidden=true;$(\"exam-result\").hidden=true;} }\nfunction lock(v){busy=v;for(const button of $(\"pending-list\").querySelectorAll(\"button\"))button.disabled=v;$(\"start\").disabled=v||($(\"mode\").value===\"exam_set\"?!!examSet:!$(\"item\").options.length);$(\"mode\").disabled=v||!!examSet;$(\"item\").disabled=v;$(\"submit\").disabled=v||closed;$(\"hint\").disabled=v||closed||hintIndex>=2;$(\"finish-exam\").disabled=v||!examRecorded||examFinished;$(\"answer\").disabled=v||closed;for(const radio of $(\"choices\").querySelectorAll(\"input\"))radio.disabled=v||closed;}\nasync function run(fn){if(busy)return;lock(true);try{await fn();}catch(e){$(\"notice\").textContent=e.message;}finally{lock(false);}}\n$(\"mode\").addEventListener(\"change\",()=>run(async()=>{await refreshGuided();filter();if($(\"mode\").value===\"exam_preparation\"){await refreshHistory();await refreshPending();}}));\nfunction renderActivity(a){$(\"pending-exams\").hidden=true;$(\"form\").hidden=false;attempt=a.attempt_id;$(\"exam-history\").hidden=true;hintIndex=0;closed=false;examRecorded=false;examFinished=false;$(\"finish-exam\").hidden=true;$(\"exam-result\").hidden=true;$(\"submit\").textContent=a.mode===\"exam_preparation\"?\"Registrar respuesta\":\"Comprobar\";$(\"prompt\").textContent=a.prompt;$(\"reason\").textContent=a.reasoning_prompt;$(\"answer\").value=\"\";$(\"choices\").replaceChildren();a.choices.forEach((c,i)=>{const l=document.createElement(\"label\");l.className=\"choice\";const r=document.createElement(\"input\");r.type=\"radio\";r.name=\"reason\";r.value=i;r.required=true;l.append(r,document.createTextNode(\" \"+c));$(\"choices\").append(l);});$(\"hint\").hidden=a.mode===\"exam_preparation\";$(\"feedback\").textContent=\"\";$(\"exercise\").hidden=false;$(\"prompt\").focus();}\nfunction renderSet(){$(\"pending-exams\").hidden=true;const n=examSet.items.filter(a=>a.recorded).length;$(\"set-status\").hidden=false;$(\"set-status\").textContent=\"Evaluación completa · \"+n+\"/\"+examSet.maximum+\" respuestas registradas\";$(\"exam-history\").hidden=true;$(\"review\").hidden=true;const next=examSet.items.find(a=>!a.recorded);if(next){renderActivity(next);}else{$(\"exercise\").hidden=false;$(\"form\").hidden=true;closed=true;examRecorded=true;examFinished=false;$(\"prompt\").textContent=\"Evaluación lista para finalizar\";$(\"feedback\").textContent=\"Todas las respuestas registradas. Finaliza para consultar los resultados.\";$(\"finish-exam\").hidden=false;$(\"prompt\").focus();}}\n$(\"start\").addEventListener(\"click\",()=>run(async()=>{if($(\"mode\").value===\"exam_set\"){examSet=await api(\"exam/set/start\",{});renderSet();return;}const a=$(\"mode\").value===\"guided\"?await api(\"guided/start\",{item_id:$(\"item\").value}):await api(\"start\",{item_id:$(\"item\").value,mode:$(\"mode\").value});renderActivity(a);}));\n$(\"hint\").addEventListener(\"click\",()=>run(async()=>{const h=await api(\"hint\",{attempt_id:attempt,index:hintIndex});hintIndex++;$(\"feedback\").textContent=h.text+\" (intento asistido)\";}));\n$(\"form\").addEventListener(\"submit\",e=>{e.preventDefault();run(async()=>{const r=await api(\"submit\",{attempt_id:attempt,answer:$(\"answer\").value,reason_choice:Number(document.querySelector('input[name=\"reason\"]:checked').value)});if(examSet&&r.status===\"RECORDED\"){examSet.items.find(a=>a.attempt_id===attempt).recorded=true;renderSet();return;}closed=r.status!==\"RETRY\";examRecorded=r.status===\"RECORDED\";$(\"finish-exam\").hidden=!examRecorded;$(\"feedback\").textContent=r.status===\"RECORDED\"?\"Respuesta registrada. No se revela la corrección durante el examen.\":(r.feedback||\"Respuesta registrada.\")+(r.accepted?\" Respuesta aceptada.\":\"\");await progress();if($(\"mode\").value===\"guided\"){await refreshGuided();filter(false);}});});\n$(\"finish-exam\").addEventListener(\"click\",()=>run(async()=>{if(examSet){const r=await api(\"exam/set/finish\",{exam_id:examSet.exam_id});examSet=null;examFinished=true;$(\"finish-exam\").hidden=true;$(\"exam-score\").textContent=\"Puntuación: \"+r.score+\"/\"+r.maximum;$(\"exam-solution\").textContent=\"\";$(\"exam-explanation\").replaceChildren();for(const [i,review] of r.reviews.entries()){const p=document.createElement(\"span\");p.style.display=\"block\";p.textContent=(i+1)+\". \"+(review.correct?\"Correcta\":\"Incorrecta\")+\" · Tu respuesta: \"+review.answer+\" · Solución: \"+review.expected+\" · \"+review.feedback;$(\"exam-explanation\").append(p);}$(\"exam-result\").hidden=false;$(\"exam-result-title\").focus();await progress();return;}if(!attempt||!examRecorded||examFinished)return;const r=await api(\"exam/finish\",{attempt_id:attempt});examFinished=true;$(\"finish-exam\").hidden=true;$(\"exam-score\").textContent=\"Puntuación: \"+r.score+\"/\"+r.maximum+(r.correct?\" · Respuesta correcta\":\" · Respuesta incorrecta\");$(\"exam-solution\").textContent=\"Tu respuesta: \"+r.answer+\" · Solución: \"+r.expected;$(\"exam-explanation\").textContent=r.feedback;$(\"exam-result\").hidden=false;$(\"exam-result-title\").focus();await progress();await refreshHistory();await refreshPending();}));\nrun(async()=>{try{items=await api(\"items\");}catch(e){await api(\"session\",{});items=await api(\"items\");}await refreshGuided();filter();examSet=await api(\"exam/set/active\");if(examSet){$(\"mode\").value=\"exam_set\";filter();renderSet();}else{const pending=await api(\"exam/pending\");if(pending.length){$(\"mode\").value=\"exam_preparation\";filter();await refreshHistory();await refreshPending();}}await progress();$(\"notice\").textContent=\"Sesión local activa. Sin datos personales.\"});\n</script></body></html>\n"
    },
    {
      "path": "sistema-maestro/pilot/mm110_m1.html",
      "blob": "d6b6b99440e267da3807e552d50cfaed25a68876",
      "content": "<!doctype html>\n<html lang=\"es\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Academia Play | MM-110 Polinomios</title>\n<style>\n*{box-sizing:border-box}body{margin:0;background:#f3f5fa;color:#18243b;font:1rem/1.55 system-ui,sans-serif}main{max-width:960px;margin:auto;padding:1rem}header{background:#142d50;color:white;padding:1.2rem}header div{max-width:928px;margin:auto}h1,h2,h3{line-height:1.25}h1{margin:.2rem 0}section{background:white;padding:1rem;border:1px solid #cbd5e1;border-radius:.8rem;margin:1rem 0}nav{display:grid;grid-template-columns:repeat(auto-fit,minmax(145px,1fr));gap:.5rem}button,select,input{font:inherit;color:inherit}button,select{max-width:100%;min-height:44px;border:1px solid #64748b;border-radius:.5rem;background:white;padding:.5rem .8rem}button{cursor:pointer}button.primary,button[aria-pressed=true]{background:#174778;color:white;border-color:#174778}button:disabled{opacity:.65;cursor:not-allowed}button:focus-visible,input:focus-visible,select:focus-visible,[tabindex]:focus-visible{outline:3px solid #b34c00;outline-offset:3px}fieldset{min-width:0;border:1px solid #b8c5d4;border-radius:.5rem;margin:1rem 0;padding:.7rem}legend{font-weight:650}label.option{display:flex;align-items:center;gap:.6rem;padding:.6rem;min-height:44px}input[type=text]{width:100%;padding:.7rem;border:1px solid #64748b;border-radius:.4rem;margin-bottom:.7rem}.expression{font-size:1.4rem;background:#eaf1fa;padding:1rem;border-radius:.5rem;overflow-wrap:anywhere}.rule{border-left:4px solid #174778;padding:.6rem 1rem;background:#eef4fa}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:250px}th,td{overflow-wrap:anywhere;padding:.6rem;border:1px solid #94a3b8;text-align:left}th{background:#eaf1fa}tr:nth-child(even){background:#f4f7fa}.feedback{padding:.8rem;background:#eaf2fb;border-left:4px solid #174778;margin-top:1rem}.ok{background:#e5f4ea;border-color:#25643f}.bad{background:#fff1e8;border-color:#a03f15}.muted{color:#48576e}a{color:#174778}[hidden]{display:none!important}progress{width:100%;height:1rem}footer{font-size:.9rem;color:#48576e}\n</style></head><body>\n<header><div><small>ACADEMIA PLAY · MM-110</small><h1>M1 · Polinomios</h1><p>Modo Repaso y práctica formativa</p></div></header>\n<main><p class=\"muted\">Piloto local. Las respuestas formativas se conservan localmente; no acreditan dominio autónomo.</p>\n<button id=\"start-exam\" type=\"button\" class=\"primary\" hidden>Iniciar examen M1</button>\n<nav id=\"families\" aria-label=\"Familias de competencias\"></nav><p id=\"notice\" role=\"status\" aria-live=\"polite\"></p><p id=\"progress\" role=\"status\"></p>\n<section id=\"review\" hidden aria-labelledby=\"review-title\"><h2 id=\"review-title\" tabindex=\"-1\"></h2><p id=\"rule\" class=\"rule\"></p><p id=\"expression\" class=\"expression\"></p>\n<form id=\"prediction\"><fieldset><legend id=\"question\"></legend><div id=\"prediction-choices\"></div></fieldset><button class=\"primary\" type=\"submit\">Comprobar predicción</button></form>\n<div id=\"worked\" hidden><h3>Construcción paso a paso</h3><div id=\"m1-area\" hidden aria-hidden=\"true\"></div><p id=\"m1-area-caption\" class=\"muted\" hidden>Modelo de áreas esquemático para x positivo. Cada región corresponde a un producto de la tabla; la identidad algebraica vale para todos los reales.</p><p id=\"review-feedback\" class=\"feedback\" role=\"status\"></p><div class=\"scroll\" tabindex=\"0\" role=\"region\" aria-label=\"Tabla del procedimiento\"><table><caption id=\"table-caption\">Organizador del procedimiento</caption><thead id=\"columns\"></thead><tbody id=\"rows\"></tbody></table></div><button id=\"next-step\" type=\"button\">Mostrar siguiente paso</button><p id=\"step-status\" role=\"status\"></p></div></section>\n<section id=\"practice\" hidden aria-labelledby=\"practice-title\"><h2 id=\"practice-title\">Práctica formativa</h2><label for=\"practice-mode\">Modalidad</label><select id=\"practice-mode\"><option value=\"free\">Práctica libre</option><option value=\"guided\">Ruta guiada A–B–C–T</option></select><p id=\"guided-status\" role=\"status\"></p><label for=\"activity\">Actividad</label><select id=\"activity\"></select><p id=\"stage\"></p><p id=\"prompt\" class=\"expression\"></p><form id=\"assessment\"><div id=\"answer\"></div><fieldset><legend id=\"reasoning\"></legend><div id=\"reason-choices\"></div></fieldset><button class=\"primary\" type=\"submit\">Comprobar respuesta</button></form><p id=\"result\" role=\"status\" hidden></p><button id=\"next-activity\" type=\"button\">Siguiente actividad</button></section>\n<section id=\"exam\" hidden aria-labelledby=\"exam-title\">\n<h2 id=\"exam-title\" tabindex=\"-1\">Evaluación acumulativa M1</h2>\n<p id=\"exam-count\" role=\"status\"></p><progress id=\"exam-progress\" aria-label=\"Respuestas registradas\" max=\"6\" value=\"0\"></progress>\n<p id=\"exam-prompt\" class=\"expression\"></p>\n<form id=\"exam-form\"><div id=\"exam-answer\"></div><fieldset><legend id=\"exam-reasoning\"></legend><div id=\"exam-choices\"></div></fieldset><button type=\"submit\" class=\"primary\">Registrar respuesta</button></form>\n<p id=\"exam-status\" role=\"status\"></p><button id=\"finish-exam\" type=\"button\" class=\"primary\" hidden>Finalizar y revisar</button>\n<div id=\"exam-review\" hidden><h3 id=\"exam-score\" tabindex=\"-1\"></h3><ol id=\"exam-reviews\"></ol><button id=\"back-study\" type=\"button\">Volver al repaso</button></div>\n</section>\n<footer role=\"contentinfo\">Escribe potencias con ^ (por ejemplo, x^2) y fracciones con /. En el examen, las soluciones se muestran al finalizar.</footer>\n</main>\n<script>/* STEM_AREA_GRID */</script>\n<script>\n\"use strict\";\nconst $=id=>document.getElementById(id);\nlet catalog, family, item, organizer, exam, examItem, guidedState, revealRows=[], step=0, busy=false;\nconst stages={A:\"Fundamentos\",B:\"Puente conceptual\",C:\"Competencia\",T:\"Transferencia\"};\nfunction node(tag,text){const e=document.createElement(tag);if(text!==undefined)e.textContent=text;return e;}\nasync function api(path,body){const options=body===undefined?{}:{method:\"POST\",headers:{\"Content-Type\":\"application/json\"},body:JSON.stringify(body)};const r=await fetch(path,options);if(r.status===409)throw new Error(\"No quedan evaluaciones inéditas en el banco actual.\");if(!r.ok)throw new Error(\"No se pudo completar la solicitud (\"+r.status+\").\");return r.json();}\nfunction lock(on){busy=on;document.querySelectorAll(\"button,select,input\").forEach(e=>e.disabled=on);if(!on&&step>=revealRows.length)$(\"next-step\").disabled=true;if(!on&&guidedState?.stage===\"COMPLETE\"){$(\"activity\").disabled=true;$(\"next-activity\").disabled=true;}}\nasync function action(fn){if(busy)return;lock(true);$(\"notice\").textContent=\"\";try{await fn();}catch(e){$(\"notice\").textContent=e.message||\"No se pudo completar la operación.\";}finally{lock(false);}}\nfunction choices(container,name,values){container.replaceChildren();values.forEach((v,i)=>{const l=node(\"label\");l.className=\"option\";const input=node(\"input\");input.type=\"radio\";input.name=name;input.value=String(i);input.required=true;l.append(input,node(\"span\",v));container.append(l);});}\nfunction choice(name){const e=document.querySelector('input[name=\"'+name+'\"]:checked');if(!e)throw new Error(\"Selecciona una opción.\");return Number(e.value);}\nfunction feedback(el,good,text){el.hidden=false;el.className=\"feedback \"+(good?\"ok\":\"bad\");el.textContent=(good?\"Correcto. \":\"Revisa el procedimiento. \")+text;}\nfunction showStep(){if(step>=revealRows.length)return;const tr=node(\"tr\");revealRows[step].forEach(v=>tr.append(node(\"td\",v)));$(\"rows\").append(tr);step++;if(family===\"F05\"){renderStemAreaGrid($(\"m1-area\"),revealRows.map(row=>row.slice(1)),step);$(\"m1-area\").hidden=false;$(\"m1-area-caption\").hidden=false;}$(\"step-status\").textContent=\"Paso \"+step+\" de \"+revealRows.length;$(\"next-step\").disabled=step>=revealRows.length;}\nfunction renderItem(){item=catalog.items.find(i=>i.id===$(\"activity\").value);if(!item)return;$(\"stage\").textContent=stages[item.stage];$(\"prompt\").textContent=item.prompt;$(\"reasoning\").textContent=item.reasoning_prompt;choices($(\"reason-choices\"),\"reason\",item.choices);$(\"answer\").replaceChildren();$(\"result\").hidden=true;\nconst names=item.operation===\"division\"?[\"Cociente\",\"Residuo\"]:item.operation===\"factor_product\"?[\"Primer factor\",\"Segundo factor\"]:[\"Respuesta\"];\nnames.forEach((name,i)=>{const l=node(\"label\",name);l.htmlFor=\"ans\"+i;const field=node(\"input\");field.id=\"ans\"+i;field.type=\"text\";field.maxLength=256;field.required=true;field.autocomplete=\"off\";$(\"answer\").append(l,field);});if(item.operation===\"degree\"){const l=node(\"label\");l.className=\"option\";const c=node(\"input\");c.type=\"checkbox\";c.id=\"undefined-degree\";c.addEventListener(\"change\",()=>{$(\"ans0\").required=!c.checked;$(\"ans0\").readOnly=c.checked;if(c.checked)$(\"ans0\").value=\"\";});l.append(c,node(\"span\",\"Grado indefinido (polinomio cero)\"));$(\"answer\").append(l);}}\nasync function refreshProgress(){const p=await api(\"/api/m1/progress\");const count=Object.values(p.families).reduce((n,f)=>n+f.completed.length,0);$(\"progress\").textContent=\"Actividades formativas aceptadas: \"+count+\" de \"+catalog.items.length+\"; sin acreditación de dominio.\";}\nasync function refreshActivities(){\n    const guided=$(\"practice-mode\").value===\"guided\";\n    guidedState=guided?await api(\"/api/m1/guided/\"+family):null;\n    $(\"guided-status\").textContent=guidedState?(guidedState.stage===\"COMPLETE\"?\"Ruta completada: 5 de 5 actividades. No acredita dominio.\":\"Etapa \"+guidedState.stage+\" · \"+stages[guidedState.stage]+\" · \"+guidedState.completed.length+\" de 5 actividades aceptadas\"):\"\";\n    $(\"activity\").replaceChildren();\n    catalog.items.filter(i=>i.family===family&&(!guidedState||guidedState.pending.includes(i.id))).forEach(i=>{const o=node(\"option\",stages[i.stage]+\" · \"+i.id.split(\"-\").pop());o.value=i.id;$(\"activity\").append(o);});\n    const complete=guidedState?.stage===\"COMPLETE\";\n    $(\"assessment\").hidden=!!complete;$(\"prompt\").hidden=!!complete;$(\"stage\").hidden=!!complete;\n    $(\"next-activity\").hidden=!!complete;$(\"activity\").disabled=!!complete;\n    if(!complete)renderItem();\n    else $(\"result\").hidden=true;\n}\n$(\"practice-mode\").addEventListener(\"change\",()=>action(refreshActivities));\nasync function selectFamily(id){organizer=await api(\"/api/m1/review/\"+id);family=id;document.querySelectorAll(\"#families button\").forEach(b=>b.setAttribute(\"aria-pressed\",String(b.dataset.family===id)));$(\"review-title\").textContent=id+\" · \"+organizer.title;$(\"rule\").textContent=organizer.rule;$(\"expression\").textContent=organizer.expression;$(\"question\").textContent=organizer.question;choices($(\"prediction-choices\"),\"prediction-choice\",organizer.choices);$(\"worked\").hidden=true;$(\"m1-area\").hidden=true;$(\"m1-area\").replaceChildren();$(\"m1-area-caption\").hidden=true;revealRows=[];step=0;$(\"rows\").replaceChildren();$(\"columns\").replaceChildren();$(\"step-status\").textContent=\"\";await refreshActivities();$(\"review\").hidden=false;$(\"practice\").hidden=false;$(\"review-title\").focus();}\n$(\"prediction\").addEventListener(\"submit\",e=>{e.preventDefault();action(async()=>{const result=await api(\"/api/m1/predict\",{family,choice:choice(\"prediction-choice\")});feedback($(\"review-feedback\"),result.correct,result.feedback);$(\"worked\").hidden=false;revealRows=result.rows;step=0;$(\"rows\").replaceChildren();const tr=node(\"tr\");organizer.columns.forEach(c=>{const th=node(\"th\",c);th.scope=\"col\";tr.append(th);});$(\"columns\").replaceChildren(tr);showStep();});});\n$(\"next-step\").addEventListener(\"click\",showStep);$(\"activity\").addEventListener(\"change\",renderItem);\n$(\"next-activity\").addEventListener(\"click\",()=>{const s=$(\"activity\");s.selectedIndex=(s.selectedIndex+1)%s.options.length;renderItem();$(\"ans0\").focus();});\n$(\"assessment\").addEventListener(\"submit\",e=>{e.preventDefault();action(async()=>{let answer=$(\"ans0\").value.trim();if(item.operation===\"degree\"){if($(\"undefined-degree\").checked)answer=null;else if(/^\\d{1,2}$/.test(answer))answer=Number(answer);else throw new Error(\"Escribe un grado entero no negativo.\");}if(item.operation===\"division\"||item.operation===\"factor_product\")answer=[answer,$(\"ans1\").value.trim()];const key=choice(\"reason\");let result;if($(\"practice-mode\").value===\"guided\"){const a=await api(\"/api/m1/guided/start\",{family,item_id:item.id});result=await api(\"/api/m1/submit\",{attempt_id:a.attempt_id,answer,reason_choice:key});}else result=await api(\"/api/m1/assess\",{item_id:item.id,answer,reason_choice:key});if(result.status===\"ASSESSED\")feedback($(\"result\"),result.accepted,result.feedback);else feedback($(\"result\"),false,result.status===\"RETRY\"?\"La comprobación no concluyó. Intenta nuevamente.\":\"Revisa el formato de la respuesta.\");await refreshProgress();if($(\"practice-mode\").value===\"guided\"&&result.status===\"ASSESSED\"&&result.accepted){await refreshActivities();feedback($(\"result\"),true,result.feedback);}});});\nasync function loadStudy(){\n    $(\"exam\").hidden=true;$(\"exam-review\").hidden=true;$(\"families\").hidden=false;$(\"progress\").hidden=false;\n    catalog=await api(\"/api/m1/catalog\");await refreshProgress();$(\"families\").replaceChildren();\n    for(const f of catalog.families){const b=node(\"button\",f.id+\" · \"+f.title);b.type=\"button\";b.dataset.family=f.id;b.setAttribute(\"aria-pressed\",\"false\");b.addEventListener(\"click\",()=>action(()=>selectFamily(f.id)));$(\"families\").append(b);}\n    await selectFamily(catalog.families[0].id);$(\"start-exam\").hidden=false;\n}\nfunction renderExam(data){\n    exam=data;for(const id of [\"review\",\"practice\",\"families\",\"progress\",\"start-exam\"])$(id).hidden=true;\n    $(\"exam\").hidden=false;$(\"exam-review\").hidden=true;\n    const n=exam.items.filter(i=>i.recorded).length;$(\"exam-count\").textContent=n+\" de \"+exam.maximum+\" respuestas registradas\";$(\"exam-progress\").max=exam.maximum;$(\"exam-progress\").value=n;\n    examItem=exam.items.find(i=>!i.recorded);$(\"exam-form\").hidden=!examItem;$(\"finish-exam\").hidden=!!examItem;\n    $(\"exam-prompt\").textContent=examItem?examItem.family+\" · \"+examItem.prompt:\"Todas las respuestas han sido registradas.\";\n    $(\"exam-answer\").replaceChildren();$(\"exam-choices\").replaceChildren();\n    if(examItem){\n        const names=examItem.operation===\"division\"?[\"Cociente\",\"Residuo\"]:examItem.operation===\"factor_product\"?[\"Primer factor\",\"Segundo factor\"]:[\"Respuesta\"];\n        names.forEach((name,i)=>{const l=node(\"label\",name);l.htmlFor=\"exam-ans\"+i;const input=node(\"input\");input.id=l.htmlFor;input.type=\"text\";input.required=true;input.maxLength=256;input.autocomplete=\"off\";$(\"exam-answer\").append(l,input);});\n        if(examItem.operation===\"degree\"){const l=node(\"label\");l.className=\"option\";const input=node(\"input\");input.type=\"checkbox\";input.id=\"exam-undefined\";input.addEventListener(\"change\",()=>{$(\"exam-ans0\").required=!input.checked;$(\"exam-ans0\").readOnly=input.checked;if(input.checked)$(\"exam-ans0\").value=\"\";});l.append(input,node(\"span\",\"Grado indefinido (polinomio cero)\"));$(\"exam-answer\").append(l);}\n        $(\"exam-reasoning\").textContent=examItem.reasoning_prompt;choices($(\"exam-choices\"),\"exam-reason\",examItem.choices);\n    }\n    $(\"exam-title\").focus();\n}\n$(\"start-exam\").addEventListener(\"click\",()=>action(async()=>{$(\"exam-status\").textContent=\"\";renderExam(await api(\"/api/m1/exam/start\",{}));}));\n$(\"exam-form\").addEventListener(\"submit\",e=>{e.preventDefault();action(async()=>{\n    let answer=$(\"exam-ans0\").value.trim();\n    if(examItem.operation===\"degree\"){if($(\"exam-undefined\").checked)answer=null;else if(/^\\d{1,2}$/.test(answer))answer=Number(answer);else throw new Error(\"Escribe un grado entero no negativo.\");}\n    if(examItem.operation===\"division\"||examItem.operation===\"factor_product\")answer=[answer,$(\"exam-ans1\").value.trim()];\n    const result=await api(\"/api/m1/submit\",{attempt_id:examItem.attempt_id,answer,reason_choice:choice(\"exam-reason\")});\n    if(result.status===\"RECORDED\"){renderExam(await api(\"/api/m1/exam/active\"));$(\"exam-status\").textContent=\"Respuesta registrada. No se revela la corrección.\";}\n    else $(\"exam-status\").textContent=result.status===\"RETRY\"?\"Comprobación inconclusa; intenta nuevamente.\":\"Revisa el formato de la respuesta.\";\n});});\n$(\"finish-exam\").addEventListener(\"click\",()=>action(async()=>{\n    const review=await api(\"/api/m1/exam/finish\",{exam_id:exam.exam_id});\n    $(\"finish-exam\").hidden=true;$(\"exam-status\").textContent=\"Evaluación finalizada.\";$(\"exam-review\").hidden=false;\n    $(\"exam-score\").textContent=\"Resultado: \"+review.score+\" de \"+review.maximum;\n    $(\"exam-reviews\").replaceChildren();for(const r of review.reviews){const i=exam.items.find(i=>i.id===r.item_id);const li=node(\"li\");li.append(node(\"h4\",i.family+\" · \"+(r.accepted?\"Correcta\":\"No aceptada\")),node(\"p\",i.prompt),node(\"p\",\"Respuesta esperada: \"+(r.expected===null?\"grado indefinido\":Array.isArray(r.expected)?r.expected.join(\"; \"):r.expected)),node(\"p\",\"Justificación: \"+i.choices[r.correct_reason]),node(\"p\",r.explanation));$(\"exam-reviews\").append(li);}\n    $(\"exam-score\").focus();\n}));\n$(\"back-study\").addEventListener(\"click\",()=>action(loadStudy));\naction(async()=>{await api(\"/api/m1/session\",{});const pending=await api(\"/api/m1/exam/active\");if(pending)renderExam(pending);else await loadStudy();});\n</script></body></html>\n"
